%footer.page-footer
  .row
    .col.s0.m2.l3
    .col.s12.m8.l6
      %nav.z-depth-0.center
        %ul
          - unless request.path == "/"
            %li
              %a{href: "/"} HOME

          - unless request.path == "/about"
            %li
              %a{href: "/about"} ABOUT

          - unless request.path == "/scraps"
            %li
              %a{href: "/scraps"} SCRAPS

          - unless request.path == "/archive"
            %li
              %a{href: "/archive"} ARCHIVE

          - if @scraps
            - unless @scraps[:upper_bound] >= @scraps[:total]
              %li{style: "float: right;"}
                %a{href: "scraps?page=#{@page + 1}"} next

            - unless @page == 0
              %li{style: "float: left;"}
                %a{href: "scraps?page=#{@page - 1}"} back
    .col.s0.m2.l3
