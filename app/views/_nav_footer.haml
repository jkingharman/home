%footer.page-footer
  .row
    .col.s12.m8.offset-m2
      %nav.z-depth-0.center
        %ul
          - unless request.path == "/about"
            %li
              %a{href: "/about"} about

          %li
            %a{href: "https://github.com/jkingharman"} github

          - unless request.path == "/"
            %li
              %a{href: "/"} home

          - unless request.path == "/fragments"
            %li
              %a{href: "/fragments"} fragments

          - unless request.path == "/archive"
            %li
              %a{href: "/archive"} archive

          - unless params[:mode].nil?
            %li{style: "float: right;"}
              %a#darkmode{href: ""} dark

          - unless params[:mode] == "light"
            %li{style: "float: right;"}
              %a#lightmode{href: ""} light

          - if @frags
            - unless @frags[:upper_bound] >= @frags[:total]
              %li{style: "float: right;"}
                %a{href: "fragments?page=#{@page + 1}"} next

            - unless @page == 0
              %li{style: "float: left;"}
                %a{href: "fragments?page=#{@page - 1}"} back
