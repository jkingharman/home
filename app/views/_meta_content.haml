.col.s0.m3.l3.hide-on-small-and-down
  #meta-content
    %p
      %span Count
      %br
      = note.count.to_s + " words"
    %p
      %span Time
      %br
      = note.time + " minutes"
    %p
      %span Tags
      %br
        - note.tags.each do |tag|
          %a{href: "/archive?tags=,#{tag}"}
            = tag
          - unless tag == note.tags.last
            %span.middot
