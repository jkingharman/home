#archive
  .row.no-margin-bottom
    #index.content.col.s12.m8.offset-m2
      %h6
        Filter ☟
      #tags
        %ul
          - @tags.each do |tag|
            %li
              %span.tag #{tag}
      #notes
        %ul
          - asc_posted_at(@content).each do |content|
            %li.entry{'data-tags': "#{content.tags}"}
              %span #{content.date}
              %a{href: "#{content.type}/#{content.slug}"} #{content.title}
