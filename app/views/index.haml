.row.no-margin-bottom
  #index
    .row.no-margin-bottom
      = haml :_sidenav
      .col.s12.m10#about-section
        %div
          %h1.greeting
            Hi, I'm Jasper :)

          %p.intro
            I work in tech and live in London and Bath. Professionally I build web apps, mainly using Ruby and JavaScript. Off the clock I'm always down to skateboard, surf or travel. Less often I also like to write or make generative art.

          %a.read-more.skew-forward-on-hover{href: "/about"}
            Read more
            %span.finger ☞
      #section-container.col.s12.m10.offset-m2
        .col.s12.l6#posts-section
          %div
            %a{href: 'posts?tags='}
              %h2.section-label Posts
            - for_index(@notes).each do |note|
              .note-overview
                %ul
                  %li
                    .title
                      %a{href: 'notes/' + "#{note.slug}"} #{note.title}
                      %span.date #{note.date}

                  %li
                    %a.hook{href: 'notes/' + "#{note.slug}"}
                      #{note.content[0...128]}...

        .col.s12.l6#contact-section
          %canvas#canvas
          %h2#overlay
            %a{href: "/contact"}
              Say hi
